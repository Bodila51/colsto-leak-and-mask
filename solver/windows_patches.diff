+# --------------------------------------------------------------------------- Windows: spawn workers
+# Windows port: there is no fork(), so the workers cannot inherit ``_G``. The parent dumps the big
+# arrays as .npy files and every spawned worker memory-maps them (the OS page cache is shared
+# between processes, so N workers do not hold N copies of the sample table).
+
+def _dump_state(d):
+    import pickle
+    d.mkdir(parents=True, exist_ok=True)
+    S: Samples = _G["S"]
+    for name in ("fi", "t", "x", "y", "h", "gs"):
+        np.save(d / f"S_{name}.npy", getattr(S, name))
+
+    def ti(name, t):
+        np.save(d / f"{name}_keys.npy", t.keys)
+        np.save(d / f"{name}_idx.npy", t.idx)
+        return t.tile
+
+    small = {"fid": S.fid, "dt": S.dt, "case": _G["case"], "tile": _G["tile"], "nc": _G["nc"],
+             "rmax": _G["rmax"], "rsil": _G["rsil"],
+             "SI": [ti(f"SI{k}", t) for k, t in enumerate(_G["SI"])],
+             "SA": ti("SA", _G["SA"]) if "SA" in _G else None,
+             "lattice": str(_G["lattice"].path) if _G.get("lattice") is not None else None}
+    # non-"cpa" silence mode (rarely used): plain pickles
+    extra = {k: _G[k] for k in ("A", "AI", "J", "JI") if k in _G}
+    with open(d / "small.pkl", "wb") as f:
+        pickle.dump((small, extra), f)
+
+
+def _win_init(d, threads=1):
+    import os
+    import pickle
+    from pathlib import Path
+    d = Path(d)
+    with open(d / "small.pkl", "rb") as f:
+        small, extra = pickle.load(f)
+    L = lambda n: np.load(d / n, mmap_mode="r")
+    S = Samples(small["fid"], L("S_fi.npy"), L("S_t.npy"), L("S_x.npy"), L("S_y.npy"), L("S_h.npy"),
+                L("S_gs.npy"), small["dt"])
+
+    def ti(name, tile):
+        t = object.__new__(_TileIndex)
+        t.keys, t.idx, t.tile = L(f"{name}_keys.npy"), L(f"{name}_idx.npy"), tile
+        return t
+
+    case = small["case"]
+    _G.clear()
+    _G.update(S=S, SI=[ti(f"SI{k}", t) for k, t in enumerate(small["SI"])], case=case, tile=small["tile"],
+              nc=small["nc"], rmax=small["rmax"], rsil=small["rsil"],
+              dem=DEM(case.cache / "dem", res=90))
+    if small["SA"] is not None:
+        _G["SA"] = ti("SA", small["SA"])
+    if small["lattice"]:
+        from .dem import ElevationLattice
+        _G["lattice"] = ElevationLattice(Path(small["lattice"]))
+    _G.update(extra)
+
