+def _http_download(url: str, dest: Path, size: int | None = None) -> None:
+    """Resumable download with requests (Windows port: no GitHub CLI on this PC)."""
+    have = dest.stat().st_size if dest.exists() else 0
+    if size is not None and have == size:
+        return
+    hdr = {"Range": f"bytes={have}-"} if have else {}
+    with requests.get(url, headers=hdr, stream=True, timeout=120, allow_redirects=True) as r:
+        if r.status_code == 416:
+            return
+        r.raise_for_status()
+        mode = "ab" if (have and r.status_code == 206) else "wb"
+        with open(dest, mode) as f:
+            for chunk in r.iter_content(1 << 22):
+                f.write(chunk)
+
+
